        </section>
        <!-- /.sidebar -->
      </aside>

      <!-- Content Wrapper. Contains page content -->
      <div class="content-wrapper" style="background-color:white">      
        <section class="content" style="background-color:white">
           <div class="contenedor-navegacion" style="background-color:white">
                <asp:ContentPlaceHolder ID="FeaturedContent" runat="server">
                    <section>
                         <asp:ContentPlaceHolder runat="server" ID="MainContent" />
                    </section>
                </asp:ContentPlaceHolder>
            </div>        
        </section><!-- /.content -->
      </div><!-- /.content-wrapper -->

      <!-- Main Footer -->
      <footer class="main-footer">
        <!-- To the right -->
        <div class="pull-right hidden-xs">          
        </div>
        <!-- Default to the left -->
        <strong>Copyright &copy; 2015 archi Gex.</strong> All rights reserved.
      </footer>

    <asp:SqlDataSource ID="SRC_Clientes" runat="server" ConnectionString="<%$ ConnectionStrings:DefaultConnection %>" SelectCommand="SELECT Clientes.nombre , Clientes.id FROM Usuarios INNER JOIN Usuario_Cliente ON Usuarios.ID = Usuario_Cliente.id_usuario INNER JOIN Clientes ON Usuario_Cliente.id_cliente = Clientes.Id WHERE Usuarios.usuario = @usuario
and usuarios.id not in (select id from usuarios where id_perfil=1 and usuario=@usuario and todos=1)
union all
SELECT Clientes.nombre, Clientes.id Clientes from clientes
WHERE 1=(select count(*) from usuarios where usuario = @usuario  and todos=1)
ORDER BY [nombre]
">
        <SelectParameters>
            <asp:SessionParameter Name="usuario" SessionField="Usuario" DefaultValue="" />
        </SelectParameters>
      </asp:SqlDataSource>
    <asp:SqlDataSource ID="SRC_Sucursal" runat="server" ConnectionString="<%$ ConnectionStrings:DefaultConnection %>" SelectCommand="SELECT [Sucursal], [Id] FROM [AdminSucursal] where id_cliente=@id_cliente and 1=(select count(*) from usuarios where usuario=@usuario and todos=1)
union all
SELECT [Sucursal], [Id] FROM [AdminSucursal] where id_cliente=@id_cliente and id in (select id_sucursal from usuario_sucursal inner join usuarios on usuario_sucursal.id_usuario=usuarios.id and usuarios.usuario=@usuario)
union all
SELECT [Sucursal], [Id] FROM [AdminSucursal] where id_cliente=@id_cliente and 1 = (select count(*) from usuario_cliente inner join usuarios on usuario_cliente.id_usuario=usuarios.id and usuarios.usuario=@usuario and usuario_cliente.id_cliente=@id_cliente and todas=1 and usuarios.id not in (select id from usuarios where id_perfil=1 and usuario=@usuario and todos=1))

ORDER BY [Sucursal]">
        <SelectParameters>
            <asp:ControlParameter ControlID="txtCliente" DefaultValue="0" Name="id_cliente" PropertyName="SelectedValue" />
            <asp:SessionParameter Name="usuario" SessionField="Usuario" DefaultValue="" />
        </SelectParameters>
      </asp:SqlDataSource>

    <!-- REQUIRED JS SCRIPTS -->

    <!-- jQuery 2.1.4 -->
    <script src="<%=ResolveClientUrl("plugins/jQuery/jQuery-2.1.4.min.js")%>"></script>
    <!-- Bootstrap 3.3.5 -->
    <script src="<%=ResolveClientUrl("bootstrap/js/bootstrap.min.js")%>"></script>
    <!-- AdminLTE App -->
    <script src="<%=ResolveClientUrl("dist/js/app.min.js")%>"></script>
    </form>
</body>
</html>
