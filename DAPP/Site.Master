            <div class="pull-left image">
              <img src="<%=ResolveClientUrl("dist/img/user.png")%>" class="img-circle" alt="User Image">
            </div>
            <div class="pull-left info">
                <!-- Marco Login -->
                <div class="marcologin">                   
                    <div class="contenido-login">              
                      <asp:LoginView  runat="server" ViewStateMode="Disabled">
                        <AnonymousTemplate>                                         
                           <a id="loginLink" runat="server" href="~/Account/Login" >Iniciar Sesión</a>
                        </AnonymousTemplate>
                        <LoggedInTemplate>
                                    <p> <a id="A1" runat="server" href="~/Account/ChangePassword.aspx" title="Cambiar Contraseña">
                                            <asp:LoginName ID="logBtt" runat="server" />
                                        </a>                                                            
                                    </p>                                    
                        </LoggedInTemplate>  
                      </asp:LoginView>
                    </div>                                              
                </div>                                              
            </div>
          </div>

                     
