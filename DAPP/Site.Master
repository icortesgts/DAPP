            <%--</div>--%>
            <li class="active"><a href="#"><i class="fa fa-link"></i> <span>Acerca De</span></a></li>
            <li><a href="Mailto:correo@dapp.com"><i class="fa fa-envelope"></i> <span>Contactenos</span></a></li>
            <li class="active"><a href="#"><i class="fa fa-link"></i> <span>Notificaciones</span></a></li>
            <li><a href="<%=ResolveClientUrl("~/Vistas/GesDoc/Page_EstadoPrestamos")%>"><asp:Label runat="server" ID="lblPrestamo" Text="Prestamos"></asp:Label></a></li>
            <li><a href="<%=ResolveClientUrl("~/Vistas/GesDoc/Page_EstadoListas")%>"><asp:Label runat="server"  ID="lblListas" Text="Listas de Chequeo"></asp:Label></a></li>
            <li><a href="<%=ResolveClientUrl("~/Vistas/GesDoc/Page_EstadoArchivo")%>"><asp:Label runat="server"  ID="LblArchivo" Text="Archivo"></asp:Label></a></li>
            <li><a href="<%=ResolveClientUrl("~/Vistas/Correspondencia/Page_MiCorrespondencia")%>"><asp:Label runat="server"  ID="LblCorrespondencia" Text="Correspondencia"></asp:Label></a></li>
            <li><a href="<%=ResolveClientUrl("http://www.greentechsupply.co/DAPP/WF")%>"><asp:Label runat="server"  ID="lbTareas" Text="Tareas Pendientes WF"></asp:Label></a></li>
