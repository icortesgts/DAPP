                    <li><a href="<%=ResolveClientUrl("~/Vistas/GesDoc/Page_Prestamos")%>">Prestamo de Documentos</a></li>
                    <li><a href="<%=ResolveClientUrl("~/Vistas/GesDoc/Page_EstadoPrestamos")%>">Estado Prestamo Documentos</a></li>
