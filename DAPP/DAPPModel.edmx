          <EntitySet Name="TERCEROS_temp" EntityType="Self.TERCEROS_temp" store:Type="Tables" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [TERCEROS_temp].[NIT] AS [NIT], 
    [TERCEROS_temp].[DIGITO DE CHEQUEO] AS [DIGITO DE CHEQUEO], 
    [TERCEROS_temp].[nit con digito chequeo] AS [nit con digito chequeo], 
    [TERCEROS_temp].[NOMBRE DE LA EMPRESA] AS [NOMBRE DE LA EMPRESA], 
    [TERCEROS_temp].[terdir] AS [terdir], 
    [TERCEROS_temp].[email] AS [email], 
    [TERCEROS_temp].[terfax] AS [terfax], 
    [TERCEROS_temp].[EXTERIOR] AS [EXTERIOR], 
    [TERCEROS_temp].[terid] AS [terid], 
    [TERCEROS_temp].[NOMBRE 1] AS [NOMBRE 1], 
    [TERCEROS_temp].[NOMBRE 2] AS [NOMBRE 2], 
    [TERCEROS_temp].[APELLIDO 1] AS [APELLIDO 1], 
    [TERCEROS_temp].[APELLIDO 2] AS [APELLIDO 2], 
    [TERCEROS_temp].[ciucod] AS [ciucod], 
    [TERCEROS_temp].[paicod] AS [paicod], 
    [TERCEROS_temp].[CELULAR] AS [CELULAR], 
    [TERCEROS_temp].[PROVEEDOR] AS [PROVEEDOR], 
    [TERCEROS_temp].[CLIENTE] AS [CLIENTE], 
    [TERCEROS_temp].[EMPLEADO] AS [EMPLEADO], 
    [TERCEROS_temp].[terperso] AS [terperso], 
    [TERCEROS_temp].[REGIMEN] AS [REGIMEN], 
    [TERCEROS_temp].[RZN SOCIAL] AS [RZN SOCIAL], 
    [TERCEROS_temp].[TELEFONO] AS [TELEFONO], 
    [TERCEROS_temp].[TIPO DE DOCUMENTO] AS [TIPO DE DOCUMENTO], 
    [TERCEROS_temp].[terweb] AS [terweb], 
    [TERCEROS_temp].[ESTADO] AS [ESTADO]
    FROM [dbo].[TERCEROS_temp] AS [TERCEROS_temp]</DefiningQuery>
